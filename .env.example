# SQL Server 2022 Developer used by compose.yaml and Spring Boot.
# Local development value only; use a separate secret in deployed environments.
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_DATABASE=nexora
MSSQL_SA_PASSWORD=change-me-local-sa-password-123!
MSSQL_PORT=1433

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=nexora;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=change-me-local-sa-password-123!

# MongoDB used for audit events, ticket comments, and notifications.
# These are example local credentials only. Use secret management in deployed environments.
MONGO_DATABASE=nexora
MONGO_USERNAME=nexora_root
MONGO_PASSWORD=change-me-local-mongo-password
MONGO_PORT=27017
MONGO_URI=mongodb://nexora_root:change-me-local-mongo-password@localhost:27017/nexora?authSource=admin

# Enable only for the documented one-time legacy SQL-to-MongoDB backfill.
MONGO_BACKFILL_ENABLED=false

# Local file storage. Keep this outside any public/static web directory.
FILE_STORAGE_ROOT=../.data/uploads

# Local-only JWT key. Replace it in every deployed environment.
JWT_SECRET=change-this-local-development-secret-32bytes

# First Admin bootstrap: opt in only with SPRING_PROFILES_ACTIVE=local or demo.
# Supply email/password locally when enabling; no account is created by default.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Frontend
VITE_API_BASE_URL=/api/v1
